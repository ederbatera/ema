# ==============================================================================
# METEOPULSE PRO EMA — VARIÁVEIS DE AMBIENTE (.env.example)
# Documentação das variáveis ativamente utilizadas pelo backend da estação
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. CONTROLE DE VERSÃO DA IMAGEM E DA APLICAÇÃO (DOCKER / RODAPÉ DA PÁGINA)
# ------------------------------------------------------------------------------
# Versão da imagem Docker e exibição dinâmica no rodapé da página web:
APP_VERSION="1.0.0"
VITE_APP_VERSION="1.0.0"
IMAGE_REPOSITORY="ederbatera/ema"

# ------------------------------------------------------------------------------
# 1. PLATAFORMA GOOGLE AI STUDIO (GEMINI API)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS PRINCIPAL: TELEMETRIA DA ESTAÇÃO EMA (MariaDB / MySQL)
# ------------------------------------------------------------------------------
# String de conexão completa para o Prisma ORM e pool de conexões:
DATABASE_URL="mysql://usuario:senha@localhost:3306/nome_do_banco?connect_timeout=20"

# Parâmetros individuais de conexão ao servidor MySQL / MariaDB:
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="nome_do_banco"
DB_TABLE_READINGS="EMA_1_2026"
DB_SSL="false"

# ------------------------------------------------------------------------------
# 3. BANCO DE DADOS SECUNDÁRIO: USUÁRIOS, AUDITORIA & SÉRIE CLIMATOLÓGICA
# ------------------------------------------------------------------------------
# Nome do banco de dados para autenticação de operadores e controle de acesso RBAC:
DB_USERS_NAME="usuarios"

# Tabelas de autenticação, auditoria e climatologia contínua:
DB_TABLE_USERS="usuarios"
DB_TABLE_USERS_LOGS="usuarios_logs"
DB_TABLE_HISTORICAL="dados_historicos"

# ------------------------------------------------------------------------------
# 4. PREVISÃO NUMÉRICA DO TEMPO (APIs EXTERNAS)
# ------------------------------------------------------------------------------
# Provedor padrão: "google" (MetNet AI) com fallback automático para "open-meteo"
WEATHER_API_PROVIDER="google"

# Chave da Google Maps Platform Weather API (obrigatória para dados do Google Weather):
WEATHER_API_KEY=""

# Endpoints das APIs de previsão meteorológica:
WEATHER_API_URL="https://weather.googleapis.com/v1/forecast/days:lookup"
OPEN_METEO_API_URL="https://api.open-meteo.com/v1/forecast"

# Tempo de retenção do cache de previsão do tempo (3600 segundos = 1 hora):
WEATHER_CACHE_TTL_SECONDS="3600"

# ------------------------------------------------------------------------------
# 5. IDENTIFICAÇÃO E COORDENADAS GEOGRÁFICAS DA ESTAÇÃO EMA
# ------------------------------------------------------------------------------
STATION_NAME="Estação Meteorológica Automática — EMA Agudos"
STATION_CODE="#BR-EMA01 • INMET / WMO"
STATION_LATITUDE="-22.467009"
STATION_LONGITUDE="-48.973334"
STATION_ALTITUDE="618"

# ------------------------------------------------------------------------------
# 6. AVISOS E ALERTAS METEOROLÓGICOS (INMET / DEFESA CIVIL)
# ------------------------------------------------------------------------------
INMET_ALERTS_API_URL="https://radarmeteorologico.com.br/api/v1/alertas"
INMET_ALERTS_UF="SP"
INMET_ALERTS_CACHE_TTL="600"

# ------------------------------------------------------------------------------
# 7. SEGURANÇA, CRIPTOGRAFIA & SESSÃO JWT
# ------------------------------------------------------------------------------
# Chave secreta para assinatura dos tokens JWT Bearer de operadores e administradores:
JWT_SECRET="sua-chave-secreta-jwt-aqui"

# ------------------------------------------------------------------------------
# 8. CAMADA DE CACHE DISTRIBUÍDO: REDIS
# ------------------------------------------------------------------------------
REDIS_URL="redis://127.0.0.1:6379"
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_RESTRICT_LOCALHOST="true"
